@using MVCFilms.Models;
@model Movie;

@{
    ViewData["Title"] = "Details";
}
@{
    var authors = new List<Author>(Model.Authors);
    var actors = new List<Actor>(Model.Actors);
    var genres = new List<Genre>(Model.Genre);
}

<div class="movie">
    <div class="img-container">
        <img src=@Model.Poster alt=@($"image_of_{Model.Title}") />
    </div>
    <div class="info-container">
        <h1>@Model.Title</h1>
        <ul>
            <li>Release date: @Model.ReleaseDate.ToString("dd MMMM yyyy")</li>
            @if(Model.ClosingDate is not null && Model.ReleaseDate != Model.ClosingDate)
            {
                <li>Closing date: @(Model.ClosingDate).ToString("dd MMMM yyyy")</li>
            }
            
            <li>
                Authors: 
                @foreach(var author in authors)
                {
                    <a href="#" class="lnk">@author.Name@(author != authors.Last() ? ", " : "")</a>
                }
            </li>
            <li>Runtime: @(Model.Runtime / 60)h @(Model.Runtime % 60)m</li>
            <li>
                Genre:
                @foreach(var genre in genres)
                {
                    <a href="#" class="lnk">@genre.Name@(genre != genres.Last() ? ", " : "")</a>
                }
            </li>
            <li>Rating: @Model.Rating.ToString("F1")</li>
            <li>
                Actors:
                @foreach(var actor in actors)
                {
                    <a href="#" class="lnk">@actor.Name@(actor != actors.Last() ? ", " : "")</a>
                }
            </li>
            <li>Country: @Model.Country</li>
        </ul>
        <p>
            @Model.Plot
        </p>
    </div>
    @if(Model.TeaserUrl != null)
    {
        <div class="teaser-container">
            <iframe src=@Model.TeaserUrl></iframe>
        </div>
    }
</div>
