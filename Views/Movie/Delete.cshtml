@model MVCFilms.Models.Movie

@{
    ViewData["Title"] = "Delete";
}

<div class="delete">
    <div class="info-container">
        <div class="img-container">
            <img src=@Model.Poster alt=@($"image_of_{Model.Title}") />
        </div>
        <span class="title">@Model.Title (@Model.ReleaseDate.Year)</span>
    </div>
    <form asp-action="Delete">
        <h3>Are you sure to delete @Model.Title?</h3>
        <span>
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-delete" />
            <a class="lnk lnk-back" asp-action="Index">Back to List</a>
        </span>
    </form>
</div>