@model IEnumerable<MVCFilms.Models.Movie>

@{
    ViewData["Title"] = "Home Page";
}


<div class="movies">
    @foreach(var movie in Model)
    {
        <a class="card" asp-action="Details" asp-route-id="@movie.Id">
            <div class="img-container">
                <img src=@movie.Poster alt=@($"image_of_{movie.Title}") />
            </div>
            <div class="info-container">
                <h2>@movie.Title (@movie.ReleaseDate.Year)</h2>
            </div>
        </a>
    }
</div>
