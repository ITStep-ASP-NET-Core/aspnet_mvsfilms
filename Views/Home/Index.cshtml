@{
    ViewData["Title"] = "Home Page";
}


<div class="movies">
    @foreach(var movie in @ViewBag.Movies)
    {
        <a href=@($"/Movie/{movie.Id}") class="card">
            <div class="img-container">
                <img src=@movie.Poster alt=@($"image_of_{movie.Title}") />
            </div>
            <div class="info-container">
                <h2>@movie.Title (@movie.ReleaseDate.Year)</h2>
            </div>
        </a>
    }
</div>
